<Window x:Class="DnsSelector.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        Title="DNS Selector"
        Height="720"
        Width="960"
        Icon="pack://application:,,,/Resources/images/dns-selector_256.png"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBackground}"
        Foreground="{DynamicResource WindowForeground}">
    <Window.Resources>
        <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource ThemedColumnHeader}"/>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="ネットワークアダプター:" VerticalAlignment="Center" Margin="0,0,8,0" />
            <ComboBox Grid.Column="1" x:Name="AdapterComboBox" Width="320" SelectionChanged="AdapterComboBox_SelectionChanged"
                      Style="{StaticResource ThemedComboBox}" VerticalAlignment="Center">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding DisplayName}" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
                <ComboBox.GroupStyle>
                    <GroupStyle>
                        <GroupStyle.HeaderTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{DynamicResource PanelBorder}" BorderThickness="0,1,0,0"
                                        Margin="0,4,0,2" Padding="0,4,0,0">
                                    <TextBlock Text="{Binding Name}" FontWeight="Bold" Foreground="Gray" FontSize="12" />
                                </Border>
                            </DataTemplate>
                        </GroupStyle.HeaderTemplate>
                    </GroupStyle>
                </ComboBox.GroupStyle>
            </ComboBox>
            <Button Grid.Column="2" x:Name="RefreshButton" Content="再読み込み" Width="80" Height="32" Padding="0" Margin="8,0,8,0"
                    Click="RefreshButton_Click" Style="{StaticResource ThemedButton}" VerticalAlignment="Center" />
            <Button Grid.Column="3" x:Name="SettingsButton" Content="⚙️" Width="36" Height="32" Padding="0"
                    Click="SettingsButton_Click" Style="{StaticResource ThemedButton}" VerticalAlignment="Center" HorizontalAlignment="Right" />
        </Grid>

        <Border Grid.Row="1" BorderBrush="{DynamicResource PanelBorder}" BorderThickness="1" Padding="10" CornerRadius="4"
                Background="{DynamicResource PanelBackground}">
            <StackPanel>
                <TextBlock x:Name="CurrentDnsTitle" Text="現在のDNS設定" FontWeight="Bold" Margin="0,0,0,4" />
                <TextBlock x:Name="CurrentDnsText" Text="DNS設定を読み込んでいます..." TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <DataGrid x:Name="ProfileGrid" Grid.Row="2" AutoGenerateColumns="False" IsReadOnly="True"
                  CanUserAddRows="False" HeadersVisibility="Column" SelectionMode="Single"
                  SelectionChanged="ProfileGrid_SelectionChanged"
                  Margin="0,10,0,10"
                  Style="{StaticResource ThemedDataGrid}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="プロバイダ" Binding="{Binding Name}" Width="140" />
                <DataGridTextColumn Header="応答速度" Width="100">
                    <DataGridTextColumn.Binding>
                        <Binding Path="LatencyMs" StringFormat="{}{0:F1} ms" TargetNullValue="未計測" />
                    </DataGridTextColumn.Binding>
                </DataGridTextColumn>
                <DataGridTextColumn Header="DNSサーバー (IPv4)" Width="220">
                    <DataGridTextColumn.Binding>
                        <Binding Path="Ipv4" Converter="{StaticResource ListJoinConverter}" />
                    </DataGridTextColumn.Binding>
                </DataGridTextColumn>
                <DataGridTextColumn Header="DNSサーバー (IPv6)" Width="260">
                    <DataGridTextColumn.Binding>
                        <Binding Path="Ipv6" Converter="{StaticResource ListJoinConverter}" />
                    </DataGridTextColumn.Binding>
                </DataGridTextColumn>
            </DataGrid.Columns>
        </DataGrid>

        <Border x:Name="DetailPanel" Grid.Row="3" BorderBrush="{DynamicResource PanelBorder}" BorderThickness="1" Padding="10" Margin="0,8,0,8" Visibility="Collapsed"
                Background="{DynamicResource PanelBackground}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0">
                    <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="14" />
                    <TextBlock Text="{Binding Description}" TextWrapping="Wrap" Margin="0,4,0,0" />
                    <TextBlock Margin="0,4,0,0">
                        <Hyperlink NavigateUri="{Binding Website}" RequestNavigate="Hyperlink_RequestNavigate"
                                  Foreground="{DynamicResource HyperlinkForeground}">
                            <TextBlock Text="{Binding Website}" />
                        </Hyperlink>
                    </TextBlock>
                    <TextBlock Text=" " Margin="0,4,0,0" />
                    <TextBlock Text="{Binding Location, StringFormat=場所: {0}, TargetNullValue=場所: 不明}" Margin="0,4,0,0" />
                    <TextBlock Text="{Binding Features}" TextWrapping="Wrap" Margin="0,4,0,0" />
                    <TextBlock Text="{Binding LatencyMs, StringFormat=応答速度: {0:F1} ms, TargetNullValue=応答速度: 未計測}" Margin="0,4,0,0" />
                    <TextBlock Text="{Binding TestedAtLocal, StringFormat=最終測定: {0:yyyy/MM/dd HH:mm}, TargetNullValue=最終測定: —}" Margin="0,4,0,0" />
                </StackPanel>
                <Button x:Name="SpeedTestButton" Grid.Row="1" Content="速度テスト" HorizontalAlignment="Right" Margin="0,8,0,0"
                        Click="SpeedTestButton_Click" Style="{StaticResource ThemedButton}" />
                <TextBlock x:Name="SpeedTestStatus" Grid.Row="2" Text="" Margin="0,4,0,0" Foreground="Orange" />
            </Grid>
        </Border>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,10">
            <Button x:Name="ApplyButton" Content="適用する" Width="140" Height="40" Click="ApplyButton_Click"
                    IsDefault="true" Style="{StaticResource ThemedButton}" />
            <Button x:Name="ResetButton" Content="DHCPに戻す" Width="140" Height="40" Margin="10,0,0,0"
                    Click="ResetButton_Click" Style="{StaticResource ThemedButton}" />
        </StackPanel>

        <TextBlock Grid.Row="5" x:Name="StatusText" TextWrapping="Wrap" />
        <TextBlock Grid.Row="6" x:Name="VersionText" Text="バージョン 0.1.0" HorizontalAlignment="Right" Margin="0,4,12,4" />
    </Grid>
</Window>