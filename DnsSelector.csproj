<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net11.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Resources\images\dns-selector.ico</ApplicationIcon>
    <AssemblyName>DnsSelector</AssemblyName>
    <RootNamespace>DnsSelector</RootNamespace>
    <Version>0.1.0</Version>
    <LangVersion>latest</LangVersion>
    <!-- WPF のネイティブ依存関係 (DirectWriteForwarder.dll など) を SingleFile 配布時に正しく抽出するための設定 -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <PublishSingleFile>true</PublishSingleFile>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\default-providers.json" />
    <EmbeddedResource Include="Resources\GeoData\nginx-geo.txt" />
    <Resource Include="Resources\images\dns-selector.ico" />
    <Resource Include="Resources\images\dns-selector_*.png" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MaxMind.GeoIP2" Version="6.1.0" />
  </ItemGroup>

</Project>
