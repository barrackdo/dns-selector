<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="WindowBackground" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="WindowForeground" Color="#1F1F1F"/>
    <SolidColorBrush x:Key="PanelBackground" Color="#F5F5F5"/>
    <SolidColorBrush x:Key="PanelBorder" Color="#D0D0D0"/>
    <SolidColorBrush x:Key="DataGridBackground" Color="#FFFFFF"/>
